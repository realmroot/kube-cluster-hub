{
  "name": "@realmroot/kube-cluster-hub",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "dev:node": "tsx --env-file-if-exists=.env control-plane/entry-node.ts",
    "build": "vite build",
    "build:node": "tsup control-plane/entry-node.ts --format esm --out-dir dist-node --external better-sqlite3",
    "build:worker": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "lint:dead-code": "knip",
    "lint": "biome check .",
    "format": "biome check --write .",
    "worker:types": "wrangler types"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-query": "^5.102.8",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "jose": "6.2.10",
    "lucide-react": "^1.35.0",
    "oidc-client-ts": "^3.5.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "knip": "6.33.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
