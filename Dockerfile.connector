FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/kube-cluster-connector ./cmd/kube-cluster-connector
COPY internal/connector ./internal/connector
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/kube-cluster-connector ./cmd/kube-cluster-connector

FROM gcr.io/distroless/static-debian13:nonroot
COPY --from=build /out/kube-cluster-connector /kube-cluster-connector
EXPOSE 8081
ENTRYPOINT ["/kube-cluster-connector"]
