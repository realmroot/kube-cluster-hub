# Public HTTPS origin of this Hub. OAuth redirects and the Resource Server URL
# are derived from it.
HUB_PUBLIC_URL=https://clusters.example.com

# OIDC provider and public PKCE client. Kubernetes must accept this same client
# ID as its OIDC audience.
OIDC_ISSUER=https://id.realmroot.dev/api/auth
OIDC_CLIENT_ID=your-public-spa-client-id

# Confidential Realmroot Application used by the Hub backend for RFC 8693 token
# exchange. Keep the secret in the deployment secret store.
HUB_CLIENT_ID=your-machine-client-id
HUB_CLIENT_SECRET=replace-with-a-worker-or-container-secret

# Node runtime and persistence. SQLite is local development only.
PORT=8080
# HUB_SQLITE_PATH=kube-cluster-hub.db
# HUB_DATABASE_URL=postgres://kube-cluster-hub:password@postgres:5432/kube-cluster-hub

# Optional standard Cluster Inventory API publication. Node supports an
# in-cluster ServiceAccount, an inline kubeconfig, or a kubeconfig file.
# INVENTORY_ENABLED=false
# INVENTORY_KUBECONFIG=<inline-kubeconfig>
# INVENTORY_KUBECONFIG_FILE=/etc/kube-cluster-hub/inventory.kubeconfig
