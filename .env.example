# Required product configuration.
HUB_PUBLIC_URL=https://clusters.example.com
HUB_UI_CLIENT_ID=your-public-spa-client-id
OIDC_ISSUER=https://id.realmroot.dev/api/auth
TOKEN_EXCHANGE_CLIENT_ID=your-machine-client-id
TOKEN_EXCHANGE_CLIENT_SECRET=replace-with-a-worker-or-container-secret

# Node runtime and persistence. SQLite is local development only.
PORT=8080
# HUB_DATABASE_URL=postgres://kube-cluster-hub:password@postgres:5432/kube-cluster-hub

# Optional standard Cluster Inventory API publication. Node supports an
# in-cluster ServiceAccount, an inline kubeconfig, or a kubeconfig file.
# INVENTORY_ENABLED=false
# INVENTORY_KUBECONFIG=<inline-kubeconfig>
# INVENTORY_KUBECONFIG_FILE=/etc/kube-cluster-hub/inventory.kubeconfig
