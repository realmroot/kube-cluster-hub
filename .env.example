GATEWAY_ADDRESS=:8080
GATEWAY_DATABASE_DSN=gateway.db
GATEWAY_PUBLIC_URL=https://clusters.example.com
GATEWAY_INVENTORY_ACCESS_URL=https://clusters.example.com
GATEWAY_INVENTORY_NAMESPACE=cluster-inventory

OIDC_ISSUER=https://identity.example.com
OIDC_AUDIENCE=kubernetes-dashboard-client
OIDC_GROUPS_CLAIM=groups
CATALOG_ADMIN_GROUPS=platform-admins

RESOURCE_SERVER_URL=https://clusters.example.com/api/agent
RESOURCE_SERVER_ISSUER=https://identity.example.com
RESOURCE_SERVER_AUTHORIZED_CLIENT_IDS=agent-client
RESOURCE_SERVER_JWT_ALGORITHMS=RS256

KUBERNETES_AGENT_READ_GROUP=cluster-access:agents:read
KUBERNETES_AGENT_WRITE_GROUP=cluster-access:agents:write
AUDIT_RETENTION=2160h
