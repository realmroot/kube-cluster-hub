PORT=8080
GATEWAY_DATABASE_DSN=control-plane.db
GATEWAY_PUBLIC_URL=https://clusters.example.com
GATEWAY_INVENTORY_ACCESS_URL=https://clusters.example.com

OIDC_ISSUER=https://identity.example.com
OIDC_AUDIENCE=kubernetes-client
OIDC_GROUPS_CLAIM=groups
CATALOG_ADMIN_GROUPS=platform-admins

RESOURCE_SERVER_URL=https://clusters.example.com/api/agent
RESOURCE_SERVER_ISSUER=https://identity.example.com
RESOURCE_SERVER_AUTHORIZED_CLIENT_IDS=authorized-toolbox-client
RESOURCE_SERVER_JWT_ALGORITHMS=RS256

DISPATCH_ISSUER=https://clusters.example.com
DISPATCH_AUDIENCE=cluster-access-connector
DISPATCH_SIGNING_PRIVATE_JWK={"kty":"EC","crv":"P-256","kid":"replace-me","alg":"ES256","use":"sig","x":"replace-me","y":"replace-me","d":"replace-me"}
CONNECTOR_STATUS_TOKEN=replace-with-a-random-secret
INVENTORY_CLUSTER_ID=management
AUDIT_RETENTION=2160h

CONNECTOR_ADDRESS=:8081
CONNECTOR_CLUSTER_ID=management
KUBERNETES_API_SERVER_URL=https://kubernetes.default.svc
KUBERNETES_CA_BUNDLE_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
KUBERNETES_SERVICE_ACCOUNT_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
DISPATCH_SIGNING_PUBLIC_JWKS={"keys":[{"kty":"EC","crv":"P-256","kid":"replace-me","alg":"ES256","use":"sig","x":"replace-me","y":"replace-me"}]}
CONTROL_PLANE_URL=https://clusters.example.com
CONNECTOR_STATUS_INTERVAL=30s

KUBERNETES_AGENT_READ_GROUP=cluster-access:agents:read
KUBERNETES_AGENT_WRITE_GROUP=cluster-access:agents:write
