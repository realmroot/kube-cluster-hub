PORT=8080
HUB_DATABASE_DSN=control-plane.db
# Use PostgreSQL for multi-replica Node/Docker deployments.
# HUB_DATABASE_URL=postgres://kube-cluster-hub:password@postgres:5432/kube-cluster-hub
HUB_PUBLIC_URL=https://clusters.example.com
HUB_UI_CLIENT_ID=your-public-oidc-client-id

OIDC_ISSUER=https://identity.example.com
KUBERNETES_OIDC_AUDIENCE=kubernetes-client
OIDC_GROUPS_CLAIM=groups
CATALOG_ADMIN_GROUPS=platform-admins

RESOURCE_SERVER_AUTHORIZED_CLIENT_IDS=authorized-toolbox-client
RESOURCE_SERVER_JWT_ALGORITHMS=RS256

AUDIT_RETENTION=2160h
